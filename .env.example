# SegueQuiz configuration.
#
# Copy this to .env and uncomment what you need, or set the same names in your
# shell. Nothing here is required: with no settings at all the app runs on JSON
# files under ./data, which is fine for local use.
#
# .env is read by `npm start` and `npm run dev`. It is gitignored - never commit
# it, and never paste a key from it into chat or a ticket.

# ---- Question drafting (optional) -----------------------------------------
# Turns on the "Draft them with Gemini" panel in the question editor. Without a
# key the panel does not appear at all. Get one from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key
#
# Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# ---- Supabase (optional) --------------------------------------------------
# Set BOTH to store quizzes, attempts and maker accounts in Postgres instead of
# JSON files. Setting only one is refused at start-up rather than silently
# falling back, so the data never ends up somewhere unexpected.
#
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
#
# The service_role key from the same page. It bypasses row level security, so it
# belongs on a server and nowhere else.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
#
# Pointing a local run at the live project means editing live data. Run the
# migrations in supabase/migrations/ before a project is used for the first time.

# ---- Server ---------------------------------------------------------------
# PORT=4000
# HOST=0.0.0.0
# SEGUEQUIZ_DATA_DIR=./data

# The origin QR codes encode. Detected automatically on Render, Railway and Fly,
# and falls back to this machine's LAN address. Set it by hand for a custom
# domain, or on a plain VM where nothing is detected.
# PUBLIC_BASE_URL=https://quiz.segueit.com

# ---- Deployment -----------------------------------------------------------
# Signs session cookies. Required once hosted: without it a new key is generated
# on every restart, which signs every maker out.
# SEGUEQUIZ_SESSION_SECRET=a-long-random-string

# Forces the Secure cookie flag on or off. Worked out from the public URL
# otherwise, which is almost always what you want.
# SEGUEQUIZ_SECURE_COOKIES=true
