# SegueQuiz configuration. Copy to .env and fill in, or set these in your shell.
# Nothing here is required: with no settings at all the app runs on JSON files.

# ---- Supabase (optional) --------------------------------------------------
# Set BOTH to store quizzes, attempts and maker accounts in Postgres.
# Leave both unset to keep using JSON files under ./data.
#
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
#
# service_role key: same page, "service_role" under Project API keys.
# It bypasses row level security, so it belongs on the server only - never
# in a browser, never in a public repository.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Server ---------------------------------------------------------------
# PORT=4000
# HOST=0.0.0.0
# PUBLIC_BASE_URL=https://quiz.example.com
# SEGUEQUIZ_DATA_DIR=./data

# ---- Maker accounts -------------------------------------------------------
# SEGUEQUIZ_SIGNUP_CODE=choose-your-own
# SEGUEQUIZ_OPEN_SIGNUP=false

# ---- Deployment -----------------------------------------------------------
# Required once the app is hosted: without it a new signing key is generated on
# every restart and every maker is signed out.
# SEGUEQUIZ_SESSION_SECRET=a-long-random-string

# Detected automatically on Render, Railway and Fly. Set by hand for a custom domain.
# PUBLIC_BASE_URL=https://quiz.example.com
